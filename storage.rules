rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isVerified() {
      return request.auth != null && (
        ('email_verified' in request.auth.token && request.auth.token.email_verified == true) ||
        ('phone_number' in request.auth.token && request.auth.token.phone_number is string && request.auth.token.phone_number.size() > 0)
      );
    }

    match /posts/{userId}/{fileName} {
      allow read: if true;
      allow write: if isVerified()
                   && request.auth.uid == userId
                   && request.resource != null
                   && request.resource.size <= 100 * 1024 * 1024
                   && (
                     request.resource.contentType.matches('image/.*') ||
                     request.resource.contentType.matches('video/.*')
                   );
      allow delete: if isVerified() && request.auth.uid == userId;
    }

    match /thumbnails/{userId}/{fileName} {
      allow read: if true;
      allow write: if isVerified()
                   && request.auth.uid == userId
                   && request.resource != null
                   && request.resource.size <= 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isVerified() && request.auth.uid == userId;
    }

    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isVerified()
                   && request.auth.uid == userId
                   && request.resource != null
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isVerified() && request.auth.uid == userId;
    }

    match /covers/{userId}/{fileName} {
      allow read: if true;
      allow write: if isVerified()
                   && request.auth.uid == userId
                   && request.resource != null
                   && request.resource.size <= 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isVerified() && request.auth.uid == userId;
    }
  }
}
